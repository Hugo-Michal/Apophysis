<Application x:Class="FractalFlameCurator.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="PanelBrush" Color="#18202A" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#2D3A49" />
    <SolidColorBrush x:Key="TextBrush" Color="#F3F6FA" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#AAB7C5" />
    <SolidColorBrush x:Key="AccentBrush" Color="#72B7FF" />
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Margin" Value="0,2,0,2" />
    </Style>
    <Style TargetType="Label">
      <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
      <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Margin" Value="3" />
      <Setter Property="Background" Value="#263545" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="BorderBrush" Value="#40566D" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="Background" Value="#10161E" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="BorderBrush" Value="#40566D" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Padding" Value="5,3" />
      <Setter Property="Margin" Value="0,2,0,2" />
      <Setter Property="Foreground" Value="Black" />
      <Setter Property="Background" Value="White" />
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="Black" />
      <Setter Property="Background" Value="White" />
    </Style>
  </Application.Resources>
</Application>
